prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: foxtrot
Description: SSH transport, authentication, connection and SFTP engine
Version: @VERSION@
Requires.private: libgcrypt @GNUTLS_PC_REQUIRES@
Libs: -L${libdir} -lfoxtrot
Libs.private: @LTLIBINTL@
Cflags: -I${includedir}
