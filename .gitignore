# Fuzz targets (libtool wrappers and objects; the sources are kept), what the
# driver saves when it finds a crash, and its working directory.  The corpus
# is kept, including the inputs that found something (crash-*).
/fuzz/fuzz-*
!/fuzz/fuzz-*.c
!/fuzz/fuzz-common.h
/fuzz/fuzz-crash.bin
/fuzz/out/

