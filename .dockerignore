# Keep what a build in the checkout left behind out of the image build
# context: the image configures and builds from a clean tree (autogen.sh
# regenerates everything below).
**/.git
**/.github
**/.claude
/autom4te.cache
/aclocal.m4
/configure
/configure~
/config.h
/config.h.in
/config.h.in~
/config.log
/config.status
/libtool
/stamp-h1
/foxtrot.pc
/build-aux
/INSTALL
/ABOUT-NLS
/m4/*
!/m4/gf_cflags.m4
/po/*
!/po/POTFILES.in
!/po/LINGUAS
!/po/Makevars
!/po/*.po
**/Makefile
**/Makefile.in
**/.deps
**/.libs
**/*.o
**/*.lo
**/*.la
**/*.a
**/*.so
**/*.so.*
**/*.dylib
**/*.log
**/*.trs
/tests/test-*
!/tests/test-*.c
/integration/interop-client
/integration/interop-server
.dirstamp
/doc/*.info
/doc/*.info-*
/doc/stamp-vti
/doc/version.texi
/foxtrot-*.tar.*
/foxtrot-[0-9]*
**/.DS_Store
