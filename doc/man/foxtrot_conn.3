.RS
Disconnect reason codes (RFC 4253 section 11.1).
.RE
.PP
.nf
typedef struct gf_conn_info
{
  enum gf_kex kex;
  enum gf_sigalg hostkey_alg;
  enum gf_cipher cipher_c2s, cipher_s2c;
  /* H of the first key exchange: what user authentication signs.  */
  const uint8_t *session_id;
  size_t session_id_len;
  /* The host key's signature over that exchange hash, as the server sent it
     (the signature blob: string algorithm name, string signature).  It stays
     the first exchange's across rekeys, as the session identifier does.
     What an agent is given with the host key and the identifier to bind a
     session to its keys (gf_agent_session_bind in agent.h).  Empty only for
     a signature larger than GF_SIG_MAX, which a key this library accepts
     does not make.  */
  const uint8_t *host_sig;
  size_t host_sig_len;
  /* The peer's identification line without CR LF, and its software
     version and comments.  */
  gf_slice peer_ident;
  gf_slice peer_software;
  /* The server's host key: the one the client verified, or the one a
     server signed with.  */
  const gf_key *host_key;
  int ext_info;			/* The peer announced RFC 8308 support.  */
} gf_conn_info;
.fi
.RS
What was negotiated, available once the connection is established and updated by each rekey.  The pointers are valid until the next rekey or until the connection is freed.
.RE
.PP
.nf
typedef struct gf_conn_events
{
  void *user;
  /* Bytes to write to the transport.  Required.  Return nonzero on
     failure, which fails the connection.  */
  int (*write) (void *user, const uint8_t *data, size_t len);
  /* Client: the server presented KEY, and it proved possession by
     signing the exchange hash.  Return 0 to trust it.  This is where
     known_hosts or a trust\-on\-first\-use policy goes.  Required for a
     client: a connection with no callback refuses every host key.  */
  int (*host_key) (void *user, const gf_key *key);
  /* The first key exchange is complete; the keys are in use.  */
  int (*established) (void *user, const gf_conn_info *info);
  /* A rekey is complete.  Messages held back during it have been sent.  */
  int (*rekeyed) (void *user, const gf_conn_info *info);
  /* Server: the client asked for service NAME (always "ssh\-userauth";
     any other is refused by the library).  Return nonzero to refuse.
     Optional; the library sends SERVICE_ACCEPT itself.  */
  int (*service_request) (void *user, gf_slice name);
  /* Client: the server accepted the service requested with
     gf_conn_request_service.  */
  int (*service_accepted) (void *user, gf_slice name);
  /* A message for the layers above (number 50 to 255).  PAYLOAD is valid
     only during the call.  Required.  Return nonzero to fail the
     connection.  */
  int (*message) (void *user, const uint8_t *payload, size_t len);
  /* An RFC 8308 extension from the peer, delivered one at a time from its
     SSH_MSG_EXT_INFO.  A client gets e.g. "server\-sig\-algs", the user key
     algorithms the server accepts.  */
  int (*extension) (void *user, gf_slice name, gf_slice value);
  /* SSH_MSG_DEBUG from the peer.  TEXT is peer\-controlled and unchecked;
     sanitize it before showing it to anyone.  */
  void (*debug) (void *user, int always_display, gf_slice text);
  /* SSH_MSG_UNIMPLEMENTED: the peer did not understand our packet number
     SEQ.  */
  void (*unimplemented) (void *user, uint32_t seq);
  /* The connection ended.  ERROR is 0 for an orderly end (we or the peer
     disconnected BY_APPLICATION), otherwise a negative status.  REASON
     is the disconnect reason sent or received (0 if none); TEXT is the
     peer's description if it sent one, peer\-controlled like debug.
     Called at most once.  */
  void (*closed) (void *user, int error, uint32_t reason, gf_slice text);
} gf_conn_events;
.fi
.PP
.nf
typedef struct gf_conn_config
{
  /* Algorithm preferences; NULL members mean the policy defaults.  A
     client that holds a known host key restricts sigalgs to that key's
     algorithms.  */
  struct gf_kex_prefs prefs;
  /* Our identification: "SSH\-2.0\-" SOFTWARE [SP COMMENTS].  NULL
     SOFTWARE means "foxtrot_VERSION".  */
  const char *software;
  const char *comments;
  /* Server only: the host keys.  The algorithms offered are those the
     keys can make (limited by prefs.sigalgs).  The keys must outlive
     the connection.  */
  gf_key *const *host_keys;
  size_t nhost_keys;
  /* Server: announce publickey\-hostbound@openssh.com in EXT_INFO, so that
     clients use the host\-bound public key method (auth.h).  Set it only
     if the authentication layer accepts that method.  */
  int announce_hostbound;
  /* Rekey after this much traffic in either direction (0: 1 GiB), this
     many packets (0: 2^28), or this long since the last key exchange
     (0: one hour).  The first is RFC 4253 section 9's advice.  */
  uint64_t rekey_bytes;
  uint64_t rekey_packets;
  uint64_t rekey_interval_us;
  /* A key exchange, the first or a rekey, must finish within this long of
     starting (0: 60 s).  */
  uint64_t kex_timeout_us;
} gf_conn_config;
.fi
.PP
.nf
typedef struct gf_conn gf_conn;
.fi
.SH FUNCTIONS
.TP
int \fBgf_conn_client_new\fP (gf_conn **out, const gf_conn_config *config, const gf_conn_events *events);
.br
int \fBgf_conn_server_new\fP (gf_conn **out, const gf_conn_config *config, const gf_conn_events *events);
Create a client or server connection.  CONFIG and EVENTS are copied; keys and strings in CONFIG are not.
.TP
void \fBgf_conn_free\fP (gf_conn *c);
Free the connection and wipe its secrets.  Does not send anything.
.TP
int \fBgf_conn_start\fP (gf_conn *c, uint64_t now_us);
Send our identification and KEXINIT.  Both ends call this once, as soon as the transport is connected.
.TP
int \fBgf_conn_receive\fP (gf_conn *c, uint64_t now_us, const uint8_t *data, size_t len);
Feed bytes read from the transport.  All of them are consumed; a partial packet is held internally.  Returns GF_OK, or a negative status after which the connection is closed (a DISCONNECT has been sent if the protocol allowed it).
.TP
uint64_t \fBgf_conn_timeout\fP (const gf_conn *c);
.br
int \fBgf_conn_on_timeout\fP (gf_conn *c, uint64_t now_us);
The next time gf_conn_on_timeout is due, or UINT64_MAX for never.
.TP
int \fBgf_conn_request_service\fP (gf_conn *c, uint64_t now_us, const char *name);
Client: ask for the service NAME (after established).
.TP
int \fBgf_conn_send\fP (gf_conn *c, uint64_t now_us, const uint8_t *payload, size_t len);
Send a message of number 50 or more (PAYLOAD includes the number; at most GF_MAX_PAYLOAD bytes).  Allowed once established.  During a key exchange the message is held, up to a limit, after which GF_ERR_AGAIN is returned and the message is not queued: retry after the rekeyed event.
.TP
int \fBgf_conn_reject_message\fP (gf_conn *c);
From inside the message callback: answer the message being delivered with SSH_MSG_UNIMPLEMENTED, because the layer above does not know its number (RFC 4253 section 11.4).
.TP
int \fBgf_conn_send_ignore\fP (gf_conn *c, uint64_t now_us, const uint8_t *data, size_t len);
Send SSH_MSG_IGNORE with DATA (traffic padding, keepalive).
.TP
int \fBgf_conn_send_debug\fP (gf_conn *c, uint64_t now_us, int always_display, const char *text);
Send SSH_MSG_DEBUG.  TEXT is UTF\-8.
.TP
int \fBgf_conn_rekey\fP (gf_conn *c, uint64_t now_us);
Start a key exchange now (also happens by itself when due).  Not before gf_conn_set_authenticated: GF_ERR_STATE.
.TP
int \fBgf_conn_set_authenticated\fP (gf_conn *c);
Tell the transport that the user has authenticated (the session does). Until then nothing rekeys: not when due, which is put off until now, and not on request; and a server takes a KEXINIT from the client for a protocol error, as OpenSSH's sshd does, since each one costs it a key exchange and a signature that nobody has earned.  A client does take a rekey the server starts, as OpenSSH's ssh does.  Only after the first key exchange has completed (GF_ERR_STATE before).  A connection used with no authentication layer has to call this to rekey at all.
.TP
int \fBgf_conn_disconnect\fP (gf_conn *c, uint64_t now_us, uint32_t reason, const char *description);
Send DISCONNECT with REASON and DESCRIPTION (may be NULL) and close.  The caller then closes the transport.
.TP
int \fBgf_conn_is_established\fP (const gf_conn *c);
.br
int \fBgf_conn_is_closed\fP (const gf_conn *c);
.TP
const gf_conn_info *\fBgf_conn_get_info\fP (const gf_conn *c);
NULL before the first key exchange completes.
.TP
uint32_t \fBgf_conn_seq\fP (const gf_conn *c, enum gf_dir dir);
Packets sent and received so far, for statistics.
